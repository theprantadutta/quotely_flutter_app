        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"facts\" (\"id\" INTEGER NOT NULL, \"content\" TEXT NOT NULL, \"ai_fact_category\" TEXT NOT NULL, \"provider\" TEXT NOT NULL, \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"date_added\" INTEGER NOT NULL, \"date_modified\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
