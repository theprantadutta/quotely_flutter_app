    {
      "name": "quotes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"quotes\" (\"id\" TEXT NOT NULL, \"author\" TEXT NOT NULL, \"content\" TEXT NOT NULL, \"tags\" TEXT NOT NULL, \"author_slug\" TEXT NOT NULL, \"length\" INTEGER NOT NULL, \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"date_added\" INTEGER NOT NULL, \"date_modified\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
