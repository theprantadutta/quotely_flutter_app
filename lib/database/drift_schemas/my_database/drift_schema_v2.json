          "sql": "CREATE TABLE IF NOT EXISTS \"authors\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"bio\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"link\" TEXT NOT NULL, \"quote_count\" INTEGER NOT NULL, \"slug\" TEXT NOT NULL, \"image_url\" TEXT NULL, \"date_added\" INTEGER NOT NULL, \"date_modified\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
