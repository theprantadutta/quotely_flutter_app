          "sql": "CREATE TABLE IF NOT EXISTS \"tags\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"slug\" TEXT NOT NULL, \"quote_count\" INTEGER NOT NULL DEFAULT 0, \"date_added\" INTEGER NOT NULL, \"date_modified\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
