<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
   <uses-permission android:name="android.permission.VIBRATE" />
   <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <uses-permission android:name="com.android.vending.BILLING" />

    <application
        android:label="Quotely"
        android:name="${applicationName}"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Play Billing's proxy activities, re-declared to add two attributes
             the library does not set. Crashlytics 8101c07c307416da1819dc7553864c1b:
             ProxyBillingActivity.onCreate throwing NullPointerException on
             PendingIntent.getIntentSender(), 4 users on 2.1.0, and the same crash
             on billing 8.0.0 for 1.2.0-2.0.0 with 19 users. It predates the
             flutter_inapp_purchase migration; moving to 9.1.0 neither caused nor
             fixed it.

             The activity reads the purchase PendingIntent out of the intent that
             started it. When the system recreates it from a restored task - after
             the process was killed while the Play sheet was up - the extras are
             gone and onCreate dereferences null. The giveaway here is the timing:
             the last breadcrumb is a screen_view over six hours before the crash,
             so nobody was tapping donate; the system was rebuilding a task.

             The two fixes usually prescribed for this are already in place and
             were checked in the 9.1.0 AAR before adding anything here: it declares
             the <queries> entry for the Play Store, so package visibility on
             Android 11+ is handled, and it sets configChanges for orientation and
             keyboard, so rotation does not recreate it. Neither covers process
             death, which is what this is - every reported event is Android 11.

             finishOnTaskLaunch makes the system finish a stale instance when the
             task is next launched instead of recreating it. A purchase interrupted
             that way is cancelled rather than crashing, which is the outcome we
             want: the user is returning from the launcher, not mid-flow, so no
             result is being waited on. excludeFromRecents keeps it from being
             offered as something to return to at all.

             Neither attribute is declared by the library, so these merge without
             tools:replace. Same fix as ai_persona. -->
        <activity
            android:name="com.android.billingclient.api.ProxyBillingActivity"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true" />
        <activity
            android:name="com.android.billingclient.api.ProxyBillingActivityV2"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true" />

        <!-- url_launcher's in-app WebView, disabled. Every link in the app opens
             externally (LaunchMode.externalApplication; mailto goes to the mail
             app), so nothing ever starts this activity on purpose. Crashlytics
             still caught it crashing in onCreate (UnsupportedOperationException,
             3.0.1) when the system restored it with no URL to show. Disabled, it
             can't be restored or launched at all. If an in-app WebView is ever
             wanted, remove this and use LaunchMode.inAppBrowserView instead. -->
        <activity
            android:name="io.flutter.plugins.urllauncher.WebViewActivity"
            android:enabled="false" />

        <!-- Glance's two list-adapter trampolines, disabled. Crashlytics:
             IllegalArgumentException "List adapter activity trampoline invoked
             without specifying target intent" from
             InvisibleActionTrampolineActivity.onCreate (Pixel 8 Pro, most
             likely Play's pre-launch robot starting every activity it finds).
             Both activities only forward the ACTION_INTENT extra that Glance
             puts in a lazy-list item's fill-in intent, and throw without it.

             Why disabling is safe: Glance builds an intent for these only for
             a click inside a LazyColumn / LazyVerticalGrid
             (ApplyAction.getFillInIntentForAction, gated on
             isLazyCollectionDescendant). Our widgets (widget/ArtWidget.kt) have
             no lazy list; their one tap is a Box clickable that becomes a
             direct PendingIntent to MainActivity, so widget taps never touch
             these. test/glance_trampoline_guard_test.dart fails if a lazy list
             is added: re-enable these then.

             Considered and rejected: android:exported="false" is already what
             the Glance AAR declares (checked in the merged manifest), so it
             can't be the fix. A subclass that swallows the bad intent would
             also need GlanceAppWidget.getComponents overridden on every widget
             and a new activity to point it at, more moving parts for code that
             never runs. Same approach as WebViewActivity above. -->
        <activity
            android:name="androidx.glance.appwidget.action.InvisibleActionTrampolineActivity"
            android:enabled="false"
            tools:replace="android:enabled" />
        <activity
            android:name="androidx.glance.appwidget.action.ActionTrampolineActivity"
            android:enabled="false"
            tools:replace="android:enabled" />

        <!-- Quote of the Day home-screen widget. It displays what the app
             saves through home_widget (lib/services/quote_widget_service.dart);
             see widget/QuoteOfTheDayWidgetProvider.kt. The three widgets are
             Glance widgets (widget/ArtWidget.kt); their receivers keep the
             class names Dart updates and pins (QuotelyWidgetKind). -->
        <receiver
            android:name=".widget.QuoteOfTheDayWidgetProvider"
            android:exported="false"
            android:label="@string/qotd_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/qotd_widget_info" />
        </receiver>

        <!-- From your saved home-screen widget: one of the person's saved
             quotes a day (lib/services/saved_widget_service.dart); see
             widget/SavedQuoteWidgetProvider.kt. -->
        <receiver
            android:name=".widget.SavedQuoteWidgetProvider"
            android:exported="false"
            android:label="@string/saved_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/saved_widget_info" />
        </receiver>

        <!-- Scene of the Day home-screen widget
             (lib/services/scene_widget_service.dart); see
             widget/SceneOfTheDayWidgetProvider.kt. -->
        <receiver
            android:name=".widget.SceneOfTheDayWidgetProvider"
            android:exported="false"
            android:label="@string/scene_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/scene_widget_info" />
        </receiver>

        <!-- Minimal quote home-screen widget: today's quote and its author,
             nothing else (reads the Quote of the Day data); see
             widget/MinimalQuoteWidgetProvider.kt. -->
        <receiver
            android:name=".widget.MinimalQuoteWidgetProvider"
            android:exported="false"
            android:label="@string/minimal_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/minimal_widget_info" />
        </receiver>

        <!-- Its background setting (page or transparent). Exported because
             the launcher starts it; it only acts on our own Minimal widgets
             (see widget/MinimalWidgetConfigureActivity.kt). -->
        <activity
            android:name=".widget.MinimalWidgetConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- The small square home-screen widget ("Today, small"): the mark
             and a very short line (reads the Quote of the Day data); see
             widget/SquareQuoteWidgetProvider.kt. -->
        <receiver
            android:name=".widget.SquareQuoteWidgetProvider"
            android:exported="false"
            android:label="@string/square_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/square_widget_info" />
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/quotely_accent" />
        <!-- If you want your foreground service to be stopped if
             your app is stopped, set android:stopWithTask to true.
             See https://developer.android.com/reference/android/R.attr#stopWithTask -->
        <service
            android:name="com.dexterous.flutterlocalnotifications.ForegroundService"        
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="To demonstrate how to use foreground services to show notifications"/>
        </service>
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- If your application checks for inAppBrowserView launch mode support -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
