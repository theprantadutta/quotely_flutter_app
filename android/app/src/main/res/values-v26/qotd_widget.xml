<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ styles for the widget picker preview (layout/qotd_widget_preview.xml):
     the app's own fonts where the launcher honours them, and a quote that
     sizes itself. The live widget draws its text in Kotlin instead
     (QuoteOfTheDayWidgetProvider), because launchers such as One UI ignore
     an app's res/font fonts inside RemoteViews. -->
<resources>
    <style name="QotdWidget.Eyebrow">
        <item name="android:fontFamily">@font/ibm_plex_mono_medium</item>
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/qotd_widget_mute</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="QotdWidget.Quote">
        <item name="android:fontFamily">@font/instrument_serif</item>
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingMultiplier">1.02</item>
        <item name="android:textColor">@color/qotd_widget_ink</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:maxLines">9</item>
        <item name="android:ellipsize">end</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">13sp</item>
        <item name="android:autoSizeMaxTextSize">30sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>
</resources>
