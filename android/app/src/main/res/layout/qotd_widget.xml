<?xml version="1.0" encoding="utf-8"?>
<!-- Quote of the Day home-screen widget. QuoteOfTheDayWidgetProvider fills it
     from what the app saved (QuoteWidgetService in Dart).

     Layers, bottom to top: the page colour, the day's poster (pre-blurred in
     Dart, cropped and rounded in Kotlin), the page-colour wash that keeps the
     type readable, then the text.

     The text is a bitmap drawn in Kotlin, in the app's process, with the
     app's fonts: RemoteViews are inflated by the launcher, which can ignore an
     app's res/font fonts (One UI does). It is drawn in white with alpha (full
     for the quote, ~64% for the eyebrow and author) and tinted here with the
     ink colour, so it still flips with the system's dark mode via
     values-night without being redrawn. Only RemoteViews-safe classes are
     used (no plain View). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/qotd_widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/qotd_poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/qotd_wash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/qotd_widget_wash"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/qotd_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:tint="@color/qotd_widget_ink"
        android:tintMode="src_in" />
</FrameLayout>
