<?xml version="1.0" encoding="utf-8"?>
<!-- Quote of the Day widget: the widget picker's preview (previewLayout,
     Android 12+). Static sample text, laid out like the real widget, which
     QuoteOfTheDayWidgetProvider draws as a bitmap instead (layout/qotd_widget.xml)
     because launchers don't reliably load an app's res/font fonts inside
     RemoteViews. Here the styles' fonts may fall back to the system's; that is
     fine for a preview. Only RemoteViews-safe classes are used. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/qotd_widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/qotd_poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/qotd_wash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/qotd_widget_wash"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/qotd_eyebrow"
            style="@style/QotdWidget.Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/qotd_widget_eyebrow" />

        <TextView
            android:id="@+id/qotd_text"
            style="@style/QotdWidget.Quote"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:text="@string/qotd_widget_sample_quote" />

        <TextView
            android:id="@+id/qotd_author"
            style="@style/QotdWidget.Author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/qotd_widget_sample_author" />
    </LinearLayout>
</FrameLayout>
