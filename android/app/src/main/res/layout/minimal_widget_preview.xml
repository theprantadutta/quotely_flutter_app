<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal quote: the widget picker's preview (previewLayout, Android 12+).
     Static sample text on the page, laid out like the real widget, which
     MinimalQuoteWidget draws as a bitmap instead (see
     layout/qotd_widget_preview.xml for why). Only RemoteViews-safe classes
     are used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/qotd_widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <TextView
        style="@style/QotdWidget.Quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/minimal_widget_sample_quote" />

    <TextView
        style="@style/QotdWidget.Author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/minimal_widget_sample_author" />
</LinearLayout>
