<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's page colour (paper, or night in dark mode): the widget
     pickers' previews, and the live widgets before Android 12, where Glance
     can't round corners or switch a colour with the theme (ArtWidget). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/qotd_widget_bg" />
    <corners android:radius="@dimen/qotd_widget_radius" />
</shape>
