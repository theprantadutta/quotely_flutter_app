<?xml version="1.0" encoding="utf-8"?>
<!-- The page with a glow, for the widget picker previews of From your saved
     and Scene of the Day (layout/saved_widget_preview.xml,
     layout/scene_widget_preview.xml): an approximation of what WidgetArt
     draws for the live widget. Colours follow values-night. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/qotd_widget_bg" />
            <corners android:radius="@dimen/qotd_widget_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="1"
                android:centerY="0"
                android:centerColor="@color/widget_preview_glow_mid"
                android:endColor="@color/widget_preview_glow_none"
                android:gradientRadius="100%p"
                android:startColor="@color/widget_preview_glow"
                android:type="radial" />
            <corners android:radius="@dimen/qotd_widget_radius" />
        </shape>
    </item>
</layer-list>
